{
  "name": "data-detective",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently -k -n api,game \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint client server shared tests scripts --max-warnings 0",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --project=game",
    "test:a11y": "playwright test --project=accessibility",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "pnpm build:client && pnpm build:server",
    "start": "node dist/server/server/index.js",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm build",
    "motion:check": "node scripts/motion.mjs check",
    "motion:render": "node scripts/motion.mjs render",
    "deploy:cloudrun": "node scripts/deploy-cloudrun.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "firebase": "^12.5.0",
    "firebase-admin": "^13.5.0",
    "gsap": "^3.14.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.548.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.56.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}

PORT=3001
NODE_ENV=development
DATA_DIR=.data
AUTH_MODE=local
PERSISTENCE_MODE=file
# Optional AI. Without it, deterministic investigations remain available.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Production cloud mode: AUTH_MODE=firebase, PERSISTENCE_MODE=firestore.
GOOGLE_CLOUD_PROJECT=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Cloud Run deployment script
GOOGLE_CLOUD_REGION=asia-south1
CLOUD_RUN_SERVICE=data-detective

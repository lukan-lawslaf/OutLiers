{
  "framework": "vite",
  "buildCommand": "pnpm build:client",
  "outputDirectory": "dist/client",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://data-detective-v2-api.onrender.com/api/:path*"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
